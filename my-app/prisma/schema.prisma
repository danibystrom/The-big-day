generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Rsvp {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  firstName  String
  lastName   String
  email      String
  phone      String
  allergies  String?
  transportSaturday Boolean @default(false)
}
